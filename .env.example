# Образец настроек. Скопируйте в .env и правьте под себя.
# Файл .env в репозиторий не попадает — он в .gitignore.
#
# Все значения ниже необязательны: без .env проект работает на значениях
# по умолчанию из src/ragmdn/config.py.

# --- База данных ---
# Совпадает с тем, что поднимает docker compose.
DATABASE_URL=postgresql://rag:rag@localhost:5432/ragmdn

# --- Языковая модель (OpenAI-совместимый API) ---
# По умолчанию — локальная Ollama, ключ не нужен.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct

# Чтобы уйти в облако, замените три строки выше. Пример для Anthropic:
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# --- Кэш модели эмбеддингов ---
# Модель весит около 2.2 ГБ. По умолчанию библиотека кладёт её во временную
# папку системного диска — если места там немного, это со временем мешает
# другим программам (у нас так перестал запускаться Docker). Укажите путь
# на диске с запасом места.
# EMBEDDING_CACHE_DIR=D:/ml-cache/fastembed

# --- Отбор документов ---
# Доля кириллицы, ниже которой документ считается непереведённым.
MIN_CYRILLIC_RATIO=0.5
